(use highlight highlight-code)

(deftest colors-a-definition
  (assert (= (highlight-code "knave" "(defn add)")
             "<span class=\"paren\">(</span><span class=\"definer\">defn</span> add<span class=\"paren\">)</span>")))

(deftest colors-a-whole-string-with-an-escaped-quote
  (assert (= (highlight-code "knave" "\"a\\\"b\"")
             "<span class=\"string\">&quot;a\\&quot;b&quot;</span>")))

(deftest colors-a-comment-up-to-the-line-end
  (assert (= (highlight-code "knave" "; note\nx")
             "<span class=\"comment\">; note</span>\nx")))

(deftest colors-keywords-and-numbers
  (assert (= (highlight-code "knave" ":x 42")
             "<span class=\"keyword\">:x</span> <span class=\"number\">42</span>")))

(deftest marks-the-result-arrow
  (assert (= (highlight-code "knave" "=> 7")
             "<span class=\"result-arrow\">=&gt;</span> <span class=\"number\">7</span>")))

(deftest accepts-non-ascii-words
  (assert (= (highlight-code "knave" "café") "café")))

(deftest keeps-whitespace-before-a-non-ascii-word
  (assert (= (highlight-code "knave" " \t\r\ncafé") " \t\r\ncafé")))

(deftest escapes-code-in-another-language
  (assert (= (highlight-code "text" "(a <b>)") "(a &lt;b&gt;)")))
