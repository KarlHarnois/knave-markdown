(use blocks block)
(use highlight highlight)
(use inlines render-inlines)
(use strings escape-html join owned replace-all)

(export render-blocks)

(def chars-to-string
  (rust "{0}.collect::<String>()"
    (fn ((iterator char)) string)))

(def percent-encode
  (rust "{0}.bytes().map(|byte| Some(byte).filter(|kept| kept.is_ascii_alphanumeric() || b\"-._~\".contains(kept)).map_or_else(|| format!(\"%{{:02X}}\", byte), |kept| char::from(kept).to_string())).collect::<String>()"
    (fn ((ref str)) string)))

(defn render-blocks (blocks)
  (let (rendered (collect (map (iter blocks) render-block)))
    (join (ref rendered) "\n")))

(defn render-block (current)
  (match current
    ((heading level text anchor)
     (render-heading level
                     (as-str text)
                     (heading-anchor (as-str text) anchor)))
    ((paragraph text)
     (str "<p>" (render-inlines (as-str text)) "</p>"))
    ((code-block language code)
     (render-code (as-str language) (as-str code)))
    ((bullet-list items) (render-list "ul" items))
    ((numbered-list items) (render-list "ol" items))
    ((table header rows) (render-table header rows))))

(type heading-anchor
  (fn ((ref str) (ref (option string)))
    string))

(defn heading-anchor (text anchor)
  (match anchor
    (none (slug text))
    ((some explicit) (owned explicit))))

(defn slug (text)
  (let (lowered (lower-case text)
        kept (chars-to-string (filter (chars (as-str lowered)) slug-char?)))
    (replace-all (as-str kept) " " "-")))

(defn slug-char? (c)
  (or (alphanumeric? c)
      (= c (char " "))
      (= c (char "-"))))

(defn render-heading (level text anchor)
  (let (id (escape-html (as-str anchor))
        fragment (percent-encode (as-str anchor)))
    (str "<h" level " id=\"" id "\" aria-labelledby=\"" id
         "-title\">" "<a class=\"anchor\" href=\"#" fragment
         "\" aria-label=\"Link to this section\">#</a>"
         "<span id=\"" id "-title\">"
         (render-inlines text)
         "</span>" "</h" level ">")))

(defn render-code (language code)
  (str "<pre><code class=\"language-"
       (escape-html language)
       "\">"
       (in-line-spans (as-str (highlighted-code language code)))
       "</code></pre>"))

(defn in-line-spans (text)
  (str "<span class=\"line\">"
       (replace-all text "\n" "\n</span><span class=\"line\">")
       "</span>"))

(defn highlighted-code (language code)
  (if (knave-code? language)
    (highlight code)
    (escape-html code)))

(defn knave-code? (language) (= language "knave"))

(defn render-list (tag items)
  (str "<" tag ">"
       (join (ref (collect (map (iter items) render-item)))
             "")
       "</" tag ">"))

(defn render-item (item)
  (str "<li>" (render-inlines (as-str item)) "</li>"))

(defn render-table (header rows)
  (str "<table><thead>"
       (render-row "th" header)
       "</thead><tbody>"
       (join (ref (collect (map (iter rows) render-body-row)))
             "")
       "</tbody></table>"))

(defn render-body-row (row) (render-row "td" row))

(defn render-row (tag cells)
  (str "<tr>"
       (join (ref (collect (map (iter cells)
                             (fn (cell) (render-cell tag cell)))))
             "")
       "</tr>"))

(defn render-cell (tag cell)
  (str "<" tag ">"
       (render-inlines (as-str cell))
       "</" tag ">"))
